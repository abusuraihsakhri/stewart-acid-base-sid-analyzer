{
  "openapi": "3.1.0",
  "info": {
    "title": "Stewart Acid Base Sid Analyzer API",
    "description": "Stewart–Figge calculation API; legacy task-audit demo endpoints are not validated for clinical decision support.",
    "version": "3.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "Operational counters returned as JSON"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Demonstration task-audit workflow (not a clinical risk score)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response (no external model inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/calculate": {
      "post": {
        "summary": "Compute SIDa, SIDe and SIG by Stewart–Figge equations",
        "description": "All strong ions including iCa and iMg are entered in mmol/L, albumin in g/L, phosphate in mmol/L, PaCO2 in mmHg.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sodium": {
                    "type": "number"
                  },
                  "potassium": {
                    "type": "number"
                  },
                  "ionized_calcium": {
                    "type": "number"
                  },
                  "ionized_magnesium": {
                    "type": "number"
                  },
                  "chloride": {
                    "type": "number"
                  },
                  "lactate": {
                    "type": "number"
                  },
                  "ph": {
                    "type": "number"
                  },
                  "pco2": {
                    "type": "number"
                  },
                  "albumin": {
                    "type": "number"
                  },
                  "phosphate": {
                    "type": "number"
                  }
                },
                "required": [
                  "sodium",
                  "potassium",
                  "ionized_calcium",
                  "ionized_magnesium",
                  "chloride",
                  "lactate",
                  "ph",
                  "pco2",
                  "albumin",
                  "phosphate"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculated SIDa, SIDe, SIG, and components"
          },
          "422": {
            "description": "Invalid input value"
          }
        }
      }
    }
  }
}
